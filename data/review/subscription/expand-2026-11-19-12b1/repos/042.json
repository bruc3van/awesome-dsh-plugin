      "plugin": {
        "name": "dsh-language-guard",
        "title": {
          "en": "Language Guard",
          "zh": "语言守卫"
        },
        "description": {
          "en": "Locks model reasoning and replies to a target language (Simplified Chinese by default): three strength levels, configurable prompt placement, periodic reminders, and a /language switch. If you also use dsh-context, consider clearing its promptPrefix / promptSuffix — its sections share this plugin's order and duplicate token cost.",
          "zh": "把模型的思考过程与回复语言锁定为指定语言（默认简体中文）：基础 / 强化 / 周期三档强度、可配置的约束落点、周期性自检提醒，并支持 /language 快速切换。若同时安装 dsh-context，建议清空它的 promptPrefix / promptSuffix —— 它注入的 section 与本插件同序，会重复消耗 token。"
        },
        "author": "sunjingzhi",
        "homepage": "https://github.com/58fly/dsh-language-guard#readme",
        "repository": {
          "url": "https://github.com/58fly/dsh-language-guard"
